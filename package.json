  "author": "mrzar1380@gmail.om",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build && node copy-proxy-server.js",
    "build:fa": "ng build angular-tailwind --configuration=fa && node copy-proxy-server.js",
    "build:en": "ng build angular-tailwind --configuration=en && node copy-proxy-server.js",
    "build:all": "concurrently \"npm run build:fa\" \"npm run build:en\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "npx playwright test --ui",
    "prettier": "prettier --config ./.prettierrc --write \"src/{app,environments}/**/*{.ts,.html,.scss,.json}\"",
    "prettier:verify": "prettier --config ./.prettierrc --check \"src/{app,environments}/**/*{.ts,.html,.scss,.json}\"",
    "prettier:staged": "pretty-quick --staged",
    "dev:ssr": "ng run angular-tailwind:serve-ssr",
    "dev:ssr2": "node --max-old-space-size=5200 node_modules/@angular/cli/bin/ng run angular-tailwind:serve-ssr",
    "serve:ssr": "node dist/server/main.js",
    "serve:ssr2": "node dist/angular-tailwind/proxy-server.mjs",
    "build:ssr": "ng build && ng run angular-tailwind:server",
    "prerender": "ng run angular-tailwind:prerender"
  },
  "private": true,
